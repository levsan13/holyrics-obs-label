# =============================================================================
#  Holyrics -> OBS  ·  configuração
#  Copie este arquivo para .env e ajuste o que precisar:
#      cp .env.example .env
#  Toda linha é opcional: o que faltar cai no valor padrão mostrado ao lado.
# =============================================================================


# --- Conexão -----------------------------------------------------------------

# Endereço do servidor web do Holyrics, sem a /view no fim.
# É o mesmo IP que aparece em Configurações > Avançado > Servidor web.
HOLYRICS_URL=http://192.168.0.6

# Onde a página local vai ficar disponível.
# Use 0.0.0.0 se o OBS estiver em OUTRO computador da rede.
HOST=127.0.0.1
PORTA=8080


# --- Tamanho da barra --------------------------------------------------------
# Precisa bater com Largura e Altura da fonte de navegador no OBS.

LARGURA=1628
ALTURA=236

# Respiro interno, em pixels.
MARGEM_H=56
MARGEM_V=10


# --- Tipografia --------------------------------------------------------------

# Lista de fontes em ordem de preferência, separadas por vírgula.
# A Montserrat é baixada automaticamente (veja BAIXAR_FONTE); as seguintes
# entram como reserva caso ela não esteja disponível.
FAMILIA=Montserrat, Segoe UI, Arial, Helvetica, sans-serif

# 700 = bold | 800 = extrabold | 900 = black
PESO=800

ENTRELINHA=1.14

# letter-spacing, em "em". Negativo aperta as letras.
ESPACAMENTO=0.004

# true deixa a letra toda em MAIÚSCULAS.
CAIXA_ALTA=false

# Teto do ajuste automático, em pixels: é o tamanho que uma estrofe curta terá.
# Em 72, slides de 1 e 2 linhas ficam do MESMO tamanho e a letra não fica
# "pulando" a cada virada. Aumente para versos curtos crescerem mais.
TAMANHO_MAX=72

# Piso, para estrofes muito longas não sumirem.
TAMANHO_MIN=14


# --- Cores -------------------------------------------------------------------

COR=#FFFFFF
COR_CONTORNO=#000000

# Espessura do contorno, em "em" — acompanha o tamanho da letra.
CONTORNO=0.056

# Opacidade (0 a 1) da sombra suave por baixo do contorno.
SOMBRA=0.60

# Fundo da barra. Vazio = transparente (o normal no OBS).
# Para uma faixa escura por trás da letra, use algo como: rgba(0,0,0,0.65)
FUNDO=


# --- Comportamento -----------------------------------------------------------

# Intervalo entre consultas ao Holyrics, em ms. O próprio Holyrics usa 100.
INTERVALO=100

# Transição ao trocar de estrofe, em ms. 0 desliga.
FADE=160

# true mostra a referência bíblica (João 3:16) acima do versículo.
MOSTRAR_REFERENCIA=false

# Consultas seguidas com falha antes de apagar a letra da tela.
# Com INTERVALO=100, o valor 30 dá cerca de 3 segundos de tolerância — evita
# piscar em falha de rede passageira.
LIMPAR_APOS_ERROS=30

# Baixar a Montserrat do Google Fonts na primeira execução e guardar em
# montserrat-800.woff2 para funcionar offline depois. false usa só a FAMILIA.
BAIXAR_FONTE=true
